# GitHub stores the reproducible text snapshot; original artifacts remain local.
# Root allowlist prevents archives, virtualenvs, aliases and personal uploads entering Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/原理与复用指南.md
!/实验记录与结论.md
!/GITHUB_INDEX.md
!/scripts/
!/configs/
!/docs/
!/models/
!/data/
!/experiments/
!/archives/

/docs/*
!/docs/*.md
!/docs/*.json
/models/**
!/models/**/
!/models/**/*.json
!/models/**/*.md
/data/**
!/data/training/
!/data/training/functional-*/
!/data/training/functional-*/*.json
!/data/training/functional-*/*.md
/experiments/**
!/experiments/functional-*/
!/experiments/functional-*/**/
!/experiments/functional-*/**/*.json
!/experiments/functional-*/**/*.jsonl
!/experiments/functional-*/**/*.md
!/experiments/functional-*/**/*.csv
!/experiments/functional-*/**/*.yaml
!/experiments/functional-*/**/*.txt
!/experiments/shared/
!/experiments/shared/metadata/
!/experiments/shared/metadata/data-sources.json
!/experiments/shared/metadata/qwen-base-revision.json
!/experiments/shared/metadata/environment-installed-packages.txt
/archives/**
!/archives/functional-*/
!/archives/functional-*/receipt.json
!/archives/functional-*/download-receipt.json
!/archives/functional-*/README.md

# Never publish runtime uploads, feedback, secrets, environments or model/data binaries.
**/demo/requests/
**/feedback.jsonl
**/.env
**/.env.*
**/*credentials*
**/*secret*.json
**/__pycache__/
**/*.pyc
**/.DS_Store
**/*.lock
**/*.log
**/*.safetensors
**/*.pt
**/*.pth
**/*.bin
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.pdf
**/*.svg
**/*.tar
**/*.gz
**/*.zip
